# Server-side only. NEVER prefix with VITE_ — anything VITE_* is inlined into the
# client bundle and would leak the platform key to every visitor (spec §3.5).

# Upstream UTC platform (same pipeline as SMS 15421)
PLATFORM_API_URL=https://utc.seebait.com/api/v1/submissions
PLATFORM_API_KEY=

# Optional: campaign salt used for MSISDN hashing on the platform side.
# Kept here only if the proxy is ever asked to pre-hash; it does not hash today.
CAMPAIGN_SALT=
